{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug: Current Python File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Debug: Pytest Suite",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "-q"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "Run: Token Yield Demo",
            "type": "debugpy",
            "request": "launch",
            "module": "examples.token_yield_demo",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Run: Assay Audit",
            "type": "debugpy",
            "request": "launch",
            "module": "assay",
            "args": [
                "audit"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Run: Assay Studio",
            "type": "debugpy",
            "request": "launch",
            "module": "assay",
            "args": [
                "studio"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true
        }
    ]
}