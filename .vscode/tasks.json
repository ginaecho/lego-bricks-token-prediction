{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Test: All",
            "type": "process",
            "command": "${command:python.interpreterPath}",
            "args": [
                "-m",
                "pytest",
                "-q"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "presentation": {
                "clear": true,
                "reveal": "always"
            }
        },
        {
            "label": "Test: Current File",
            "type": "process",
            "command": "${command:python.interpreterPath}",
            "args": [
                "-m",
                "pytest",
                "-q",
                "${relativeFile}"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "test",
            "presentation": {
                "clear": true,
                "reveal": "always"
            }
        },
        {
            "label": "Run: Token Yield Demo",
            "type": "process",
            "command": "${command:python.interpreterPath}",
            "args": [
                "-m",
                "examples.token_yield_demo"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "clear": true,
                "reveal": "always"
            }
        },
        {
            "label": "Run: Assay Audit",
            "type": "process",
            "command": "${command:python.interpreterPath}",
            "args": [
                "-m",
                "assay",
                "audit"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "clear": true,
                "reveal": "always"
            }
        },
        {
            "label": "Run: Assay Studio",
            "type": "process",
            "command": "${command:python.interpreterPath}",
            "args": [
                "-m",
                "assay",
                "studio"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "clear": true,
                "reveal": "always"
            }
        }
    ]
}